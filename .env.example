# Google API Configuration
# Copy this file to .env.local and fill in your credentials

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-client-id-here

# Google API Key (from Google Cloud Console)
VITE_GOOGLE_API_KEY=your-api-key-here

# Set to 'true' to enable verbose sync logging in the console
# VITE_STRATA_DEBUG_SYNC=true

# Optional: Google Cloud project number used by the Drive Picker (setAppId).
# Derived from the client ID when unset; only set this if your client ID is not
# of the form <projectNumber>-<hash>.apps.googleusercontent.com.
# VITE_GOOGLE_APP_ID=123456789012
